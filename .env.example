# Copy this file to .env.local. Never commit the real values.
# Generate SESSION_SECRET:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Generate the password hash using: npm run admin:password
ADMIN_PASSWORD_HASH=

# Public origin, no path/query. Leave empty in local development.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_SITE_URL=

# Enable only behind your own trusted reverse proxy. See README.
TRUST_PROXY=0

# 图片防盗链。默认开启：跨站 Referer 拒绝返回 /media 与 /icons，无 Referer（直开、爬虫、分享）始终放行。
# 设为 0 完全关闭。
ASSET_HOTLINK_PROTECTION=1

# 额外允许嵌入本站图片的域名，逗号分隔。留空表示不放行任何站外来源。
# 例如需要在微信文章里显示预览图时，可填 weixin.qq.com
ASSET_REFERRER_ALLOWLIST=

# MySQL 运行库。格式 mysql://user:password@host:port/database
# 本机开发可用隔离实例（见 docs/MySQL 迁移计划.md），生产请用受管 MySQL，需要 TLS 时在 URL 加 ?ssl=1。
MYSQL_URL=
# 连接池上限，默认 10。多进程部署时总连接数 = 进程数 x 本值，注意别超过 MySQL max_connections。
MYSQL_POOL_SIZE=10
# 运行库驱动。mysql 走数据库；不设置视为 json（JSON 分支仅供回滚与「没有数据库的测试」使用，P11 删除）。
STORE_DRIVER=mysql
# 隔离测试库，供 npm run test:store 使用。不设置则跳过那组测试。
MYSQL_TEST_URL=
# 规模验证库，供 npm run scale:check 使用（会被灌入大量合成数据）。
MYSQL_SCALE_URL=
# P9 最小权限的三个连接（npm run db:grants 用）：
#   MYSQL_URL          应用账号 —— 只有 SELECT/INSERT/UPDATE/DELETE，不含任何 DDL
#   MYSQL_MIGRATE_URL  迁移账号 —— 持有 DDL，只有 db:migrate / db:reindex 用
#   MYSQL_RO_URL       只读账号 —— 只能读已发布目录的视图，看不到 users 的口令哈希
#   MYSQL_ADMIN_URL    管理员 —— 只给 db:grants 用来建账号与视图
MYSQL_MIGRATE_URL=
MYSQL_RO_URL=
MYSQL_ADMIN_URL=
# 目录每页条目数，默认 60，上限 500。只在超过一页时才显示分页控件。
CATALOG_PAGE_SIZE=

# 媒体存储驱动：local（默认，写 data/media）| s3（S3 兼容对象存储）。
# 多进程/多副本部署必须用 s3 —— 本地磁盘上的图片只有那一台机器有，其余副本必然 404。
MEDIA_DRIVER=local
# 下面几项在 MEDIA_DRIVER=s3 时必填。自建服务（MinIO 等）保持 S3_FORCE_PATH_STYLE=1。
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=media
S3_FORCE_PATH_STYLE=1
# 仅在用临时凭证（STS）时填写。
S3_SESSION_TOKEN=
