{
  "name": "ashare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "admin:password": "node scripts/hash-password.mjs",
    "backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "db:grants": "node --env-file-if-exists=.env.local scripts/db-grants.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs",
    "test:db": "node --env-file-if-exists=.env.local --test --test-concurrency=1 tests/db.test.mjs tests/store-sql.test.mjs tests/catalog-sql.test.mjs tests/search-sql.test.mjs tests/write-path.test.mjs tests/users.test.mjs tests/grants.test.mjs",
    "db:import": "node --env-file-if-exists=.env.local scripts/db-import-json.mjs",
    "db:reindex": "node --env-file-if-exists=.env.local scripts/db-reindex.mjs",
    "user": "node --env-file-if-exists=.env.local scripts/user-manage.mjs",
    "media:check": "node --env-file-if-exists=.env.local scripts/media-check.mjs",
    "scale:check": "node --env-file-if-exists=.env.local scripts/scale-check.mjs",
    "test:store": "node --env-file-if-exists=.env.local --test tests/store-sql.test.mjs",
    "content:audit": "node --env-file-if-exists=.env.local scripts/content-audit.mjs",
    "smoke:detail": "node --env-file-if-exists=.env.local scripts/smoke-detail.mjs",
    "seed:drift": "node --env-file-if-exists=.env.local scripts/seed-drift.mjs",
    "seed:sync": "node --env-file-if-exists=.env.local scripts/seed-sync.mjs",
    "merge:guides": "node scripts/merge-guides.mjs",
    "add:trending": "node scripts/add-trending.mjs",
    "stale-links": "node --env-file-if-exists=.env.local scripts/stale-links.mjs",
    "verify:report": "node scripts/verify-report-refs.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "mysql2": "^3.24.5",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
