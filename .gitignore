# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ashare runtime data
# data/icons/ 是提交进仓库的本地图标，不忽略
data/store/
public/media/
backups/

# agent tool state
.mimosa/
.v2c/
.zcode/

# codebase-memory 图谱产物（本地产物，随本地代码变动，不入库）
# 由 codebase-memory-mcp index_repository(persistence=true) 生成：
#   graph.db.zst 约 1.1MB 压缩图谱 · artifact.json 记录 commit 与节点数 · .gitattributes 工具自动生成
# 需要与团队共享图谱时，删掉下面这行并提交。
.codebase-memory/
